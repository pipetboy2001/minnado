# Se validan al arrancar el servidor (src/lib/env.ts).

# Neon connection string (Neon dashboard > Connection Details > "Pooled connection")
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require"

# Auth.js (NextAuth) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"

# SMTP — used to send "recuperar contraseña" emails (opcional; si se
# configura, SMTP_HOST, SMTP_USER y SMTP_PASS van juntos)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="replace-with-an-app-password"
